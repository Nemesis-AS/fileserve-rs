STORAGE_PATH=/path/to/storage
JWT_SECRET=jwt_secret
TUS_MAX_SIZE=5368709120
# Default storage quota (GB) for new users when none is specified.
# Optional — the config layer falls back to 20 when unset.
# DEFAULT_QUOTA_GB=20

# Comma-separated origins allowed to make credentialed cross-origin requests.
# Optional — defaults to the Vite dev-server origins. The frontend is served
# same-origin in production, so set this empty (ALLOWED_ORIGINS=) there to
# disable cross-origin access entirely.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Self-update ---------------------------------------------------------
# The server checks this repo's GitHub releases on boot and every 24 hours,
# and can install a newer build on an admin's request. All optional.

# Repository whose releases are the update channel.
# Optional — defaults to Nemesis-AS/fileserve-rs.
# UPDATE_REPO=Nemesis-AS/fileserve-rs

# API root. Point at a mirror, or at a local fixture server when testing the
# updater. The host given here is trusted for downloads, alongside GitHub's.
# Optional — defaults to https://api.github.com.
# UPDATE_API_BASE=https://api.github.com

# Set false to disable update checks and refuse installs outright. Recommended
# wherever the binary is package-managed or root-owned and the server should
# not be rewriting it.
# Optional — defaults to true.
# SELF_UPDATE_ENABLED=true

# How "Restart now" restarts. `spawn` launches a successor, watches it come up,
# and rolls back if it doesn't. `exit` just exits and lets a service manager
# start the replacement — required under systemd or Docker, where a spawned
# child would be killed along with its parent. `auto` detects which to use.
# NOTE: under `exit`, the supervisor MUST have a restart policy configured
# (systemd `Restart=always`, Docker `--restart unless-stopped`) or "Restart
# now" will simply stop the server.
# Optional — defaults to auto.
# UPDATE_RESTART_MODE=auto