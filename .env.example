STORAGE_PATH=/path/to/storage
JWT_SECRET=jwt_secret
TUS_MAX_SIZE=5368709120
# Default storage quota (GB) for new users when none is specified.
# Optional — the config layer falls back to 20 when unset.
# DEFAULT_QUOTA_GB=20

# Comma-separated origins allowed to make credentialed cross-origin requests.
# Optional — defaults to the Vite dev-server origins. The frontend is served
# same-origin in production, so set this empty (ALLOWED_ORIGINS=) there to
# disable cross-origin access entirely.
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Send the session cookie with `Secure`, and add HSTS to responses.
# Leave this off unless there is HTTPS in front of the server: a `Secure`
# cookie is dropped outright over plain HTTP, so turning it on without TLS
# means nobody can sign in.
# Optional — defaults to false.
# COOKIE_SECURE=false

# How many reverse proxies sit in front of this server. Zero means
# `X-Forwarded-For` is ignored entirely and rate limits key on the peer
# address, which is the only safe reading when the server might be exposed
# directly. Set it to the number of proxies that append to the header, and make
# sure the one closest to the client overwrites rather than appends.
# Optional — defaults to 0.
# TRUSTED_PROXY_HOPS=0

# Gap between maintenance sweeps. The sweep clears uploads abandoned past their
# expiry, and on a demo host also reaps expired accounts.
# Optional — defaults to 300 (minimum 10).
# MAINTENANCE_INTERVAL_SECS=300

# --- Demo mode -----------------------------------------------------------
# For running a public try-it-out instance. Off by default and inert when off;
# nothing below is read unless DEMO_MODE is on, and the provisioning route does
# not exist at all. See deploy/README.md and deploy/.env.demo.example.
#
# With it on: anyone can provision a throwaway account, which expires along
# with its files; the public files section is scoped to the visitor's own
# uploads; share links are clamped; and every administrative mutation is
# refused, including for a real admin.

# Optional — defaults to false.
# DEMO_MODE=false

# Per-visitor quota, and how long the account and its files survive.
# Optional — default to 200 and 120.
# DEMO_QUOTA_MB=200
# DEMO_USER_TTL_MINUTES=120

# Per-file ceiling. The effective limit is min(this, TUS_MAX_SIZE), so no edit
# to the admin-editable settings row can raise it.
# Optional — defaults to 25.
# DEMO_MAX_UPLOAD_MB=25

# Provisioning refuses past either of these. Worst-case disk usage is
# DEMO_MAX_ACCOUNTS × DEMO_QUOTA_MB before deduplication.
# Optional — default to 50 and 10.
# DEMO_MAX_ACCOUNTS=50
# DEMO_TOTAL_STORAGE_GB=10

# In-process throttle on provisioning, keyed by client address. A backstop
# behind the reverse proxy's rate limit, not a replacement for it.
# Optional — defaults to 3.
# DEMO_PROVISION_PER_IP_PER_HOUR=3

# Ceiling on share-link lifetime, further clamped to whatever is left of the
# account's own TTL so a link cannot outlive the file it points at.
# Optional — defaults to 60.
# DEMO_SHARE_MAX_MINUTES=60

# --- Self-update ---------------------------------------------------------
# The server checks this repo's GitHub releases on boot and every 24 hours,
# and can install a newer build on an admin's request. All optional.

# Repository whose releases are the update channel.
# Optional — defaults to Nemesis-AS/fileserve-rs.
# UPDATE_REPO=Nemesis-AS/fileserve-rs

# API root. Point at a mirror, or at a local fixture server when testing the
# updater. The host given here is trusted for downloads, alongside GitHub's.
# Optional — defaults to https://api.github.com.
# UPDATE_API_BASE=https://api.github.com

# Set false to disable update checks and refuse installs outright. Recommended
# wherever the binary is package-managed or root-owned and the server should
# not be rewriting it.
# Optional — defaults to true.
# SELF_UPDATE_ENABLED=true

# How "Restart now" restarts. `spawn` launches a successor, watches it come up,
# and rolls back if it doesn't. `exit` just exits and lets a service manager
# start the replacement — required under systemd or Docker, where a spawned
# child would be killed along with its parent. `auto` detects which to use.
# NOTE: under `exit`, the supervisor MUST have a restart policy configured
# (systemd `Restart=always`, Docker `--restart unless-stopped`) or "Restart
# now" will simply stop the server.
# Optional — defaults to auto.
# UPDATE_RESTART_MODE=auto